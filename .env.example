# Vercel Postgres - Vercel'de Storage > Postgres ekleyince otomatik gelir
# Lokal geliştirmede boş bırakırsanız data/submissions.json dosyasına yazılır
POSTGRES_URL=

# Resend API key (resend.com'dan alın). Boşsa e-posta gönderimi yapılamaz.
RESEND_API_KEY=

# Gönderen adresi. Resend'de doğrulanmış domain gerekir, test için
# "Tepebaşı Gençlik <onboarding@resend.dev>" kullanabilirsiniz
MAIL_FROM=Tepebaşı Gençlik <onboarding@resend.dev>

# Admin panel girişi için şifre (mutlaka değiştirin)
ADMIN_PASSWORD=tepebasi2025

# Cookie imzalama anahtarı (rastgele uzun bir string)
ADMIN_SESSION_SECRET=please-replace-with-a-long-random-string
