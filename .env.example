# Neon/Vercel Postgres - Vercel'de Storage > Neon ekleyince otomatik gelir
# Lokal geliştirmede boş bırakırsanız data/submissions.json dosyasına yazılır
POSTGRES_URL=

# Gmail SMTP — kendi Gmail adresinizden mail göndermek için
# 1) Gmail'de 2FA açık olmalı
# 2) https://myaccount.google.com/apppasswords adresinden 16 haneli "App Password" üretin
GMAIL_USER=ornek@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# (Opsiyonel) Gönderen olarak görünecek isim
MAIL_FROM_NAME=Tepebaşı 29 Ekim Gençlik Merkezi

# Admin panel girişi için şifre (mutlaka değiştirin)
ADMIN_PASSWORD=tepebasi2025

# Cookie imzalama anahtarı (rastgele uzun bir string)
ADMIN_SESSION_SECRET=please-replace-with-a-long-random-string
